{
 "duration": 25.79,
 "subtitles": [
  {
   "start": 0.0,
   "end": 1.64,
   "text": "He contado las caras."
  },
  {
   "start": 1.59,
   "end": 3.17,
   "text": "Las de esa cosa."
  },
  {
   "start": 3.17,
   "end": 4.93,
   "text": "Las conozco a todas."
  },
  {
   "start": 4.93,
   "end": 6.47,
   "text": "Comí con ellos."
  },
  {
   "start": 6.47,
   "end": 7.59,
   "text": "Hice turnos con ellos."
  },
  {
   "start": 8.44,
   "end": 9.93,
   "text": "Todas menos una."
  },
  {
   "start": 9.88,
   "end": 11.7,
   "text": "He buscado en el registro."
  },
  {
   "start": 11.7,
   "end": 14.76,
   "text": "Tripulación, laboratorio, voluntarios."
  },
  {
   "start": 14.76,
   "end": 15.28,
   "text": "No está."
  },
  {
   "start": 15.43,
   "end": 16.97,
   "text": "Y aun así la conozco."
  },
  {
   "start": 16.92,
   "end": 18.7,
   "text": "Es la que veo en las cámaras."
  },
  {
   "start": 18.7,
   "end": 20.4,
   "text": "La que sigo viendo cuando cierro los ojos."
  },
  {
   "start": 20.55,
   "end": 22.17,
   "text": "No está en el registro porque nunca fue nadie."
  },
  {
   "start": 22.32,
   "end": 25.04,
   "text": "Y si está ahí dentro, con ellos… es que ya no está solo en mi cabeza."
  }
 ],
